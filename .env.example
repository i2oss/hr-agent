# No inline comments: `docker run --env-file` would keep them as part of the value.
# Ridgeline HR Agent: every environment variable the app reads (SPEC §3.3).
# Copy to .env for local runs. No real values here: secrets live only in Render's dashboard.

# anthropic | openai_compat | fake
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
# secret
LLM_API_KEY=
# openai_compat only (Groq, OpenRouter, Gemini, Ollama)
LLM_BASE_URL=
# groundedness judge (evals only)
JUDGE_MODEL=claude-sonnet-5-5

# local | voyage (switching needs `make index`)
EMBEDDINGS_PROVIDER=local
# secret, only when voyage
VOYAGE_API_KEY=

RETRIEVAL_TOP_K=5
# hybrid | vector
RETRIEVAL_MODE=hybrid
# unset = the calibrated default in app/config.py
# EVIDENCE_THRESHOLD=

# the Demo Date (a Monday)
DEMO_TODAY=2026-11-02

# default http://127.0.0.1:$PORT/mcp/policy/
MCP_POLICY_URL=
# default http://127.0.0.1:$PORT/mcp/hr/
MCP_HR_URL=

# false for local eval runs
RATE_LIMITS_ENABLED=true
# messages per IP per 10 minutes
RATE_LIMIT_PER_IP=20
MAX_MESSAGE_CHARS=2000
MAX_TURNS_PER_SESSION=30
# site-wide, per UTC day
DAILY_MESSAGE_CAP=100
# secret; header X-Eval-Bypass skips the rate limits
EVAL_BYPASS_KEY=

# set by Render
PORT=8000
