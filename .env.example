# Ridgeline HR Agent: every environment variable the app reads (SPEC §3.3).
# Copy to .env for local runs. No real values here: secrets live only in Render's dashboard.

LLM_PROVIDER=anthropic            # anthropic | openai_compat | fake
LLM_MODEL=claude-sonnet-5-5
LLM_API_KEY=                      # secret
LLM_BASE_URL=                     # openai_compat only (Groq, OpenRouter, Gemini, Ollama)
JUDGE_MODEL=claude-sonnet-5-5     # groundedness judge (evals only)

EMBEDDINGS_PROVIDER=local         # local | voyage (switching needs `make index`)
VOYAGE_API_KEY=                   # secret, only when voyage

RETRIEVAL_TOP_K=5
RETRIEVAL_MODE=hybrid             # hybrid | vector
# EVIDENCE_THRESHOLD=             # unset = the calibrated default in app/config.py

DEMO_TODAY=2026-11-02             # the Demo Date (a Monday)

MCP_POLICY_URL=                   # default http://127.0.0.1:$PORT/mcp/policy/
MCP_HR_URL=                       # default http://127.0.0.1:$PORT/mcp/hr/

RATE_LIMITS_ENABLED=true          # false for local eval runs
RATE_LIMIT_PER_IP=20              # messages per IP per 10 minutes
MAX_MESSAGE_CHARS=2000
MAX_TURNS_PER_SESSION=30
DAILY_MESSAGE_CAP=300             # site-wide, per UTC day
EVAL_BYPASS_KEY=                  # secret; header X-Eval-Bypass skips the rate limits

PORT=8000                         # set by Render
