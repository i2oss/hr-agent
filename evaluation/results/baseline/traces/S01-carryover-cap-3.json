              "passages": [
                {
                  "doc_id": "RSE-PTO-01",
                  "title": "Paid Time Off Policy",
                  "section": "5.1",
                  "section_heading": "Carryover cap",
                  "text": "You can carry over up to 5 unused PTO days into the next calendar year. On December 31, any unused days above the 5-day cap are forfeited.\nForfeited days are not paid out. The HR Portal shows your expected carryover from the autumn onwards, so you can plan to use the rest of your PTO before the end of the year. Carried-over days appear in your balance on January 1 and are used like any other PTO.",
                  "score": 0.0328
                },
                {
                  "doc_id": "RSE-PTO-01",
                  "title": "Paid Time Off Policy",
                  "section": "5.2",
                  "section_heading": "Leave over year-end",
                  "text": "If you are on approved leave that spans December 31, you can carry over up to 10 unused PTO days instead of 5.\nThis applies to approved leave under the Leave of Absence Policy, such as parental leave, that is in progress on December 31. It is applied automatically when your leave is recorded in the HR Portal; you don't need to request it.",
                  "score": 0.032
                },
                {
                  "doc_id": "RSE-PTO-01",
                  "title": "Paid Time Off Policy",
                  "section": "3.2",
                  "section_heading": "Company holidays inside PTO",
                  "text": "A company holiday that falls inside your PTO dates is not deducted from your PTO balance. Only your scheduled working days are charged. Which days are company holidays depends on your home office calendar; see the Holiday Calendar & Observance policy (RSE-HOL-01 \u00a71.3).\nWhen you enter dates in the HR Portal, it works out the PTO days for you using your home office's calendar. For example, for an employee of a US office, a request for Wednesday to Friday in a week where Wednesday is a US company holiday is charged as 2 PTO days. The same request from an employee of the Toronto office may be charged differently, because the Toronto office follows the Canada calendar.",
                  "score": 0.0308
                },
                {
                  "doc_id": "RSE-PTO-01",
                  "title": "Paid Time Off Policy",
                  "section": "5.3",
                  "section_heading": "Leaving Ridgeline",
                  "text": "If you leave Ridgeline, any payout of unused PTO is handled by HR at separation.\nPlan your remaining PTO with your manager once you have given notice; approved PTO in your notice period is taken as normal. HR confirms your final balance and how it is handled in your final pay. Questions about your own situation go to the HR Service Desk.",
                  "score": 0.0306
                },
                {
                  "doc_id": "RSE-PTO-01",
                  "title": "Paid Time Off Policy",
                  "section": "2.3",
                  "section_heading": "Interns",
                  "text": "Interns earn 5 days of PTO per internship, whatever its length. Unused intern PTO is not carried over or paid out.\nInterns request PTO in the HR Portal like everyone else, and the notice and approval rules in \u00a74 apply. An intern who later joins Ridgeline as a full-time or part-time employee starts accruing under \u00a72.1 or \u00a72.2 from their new hire date.",
                  "score": 0.0297
                }
