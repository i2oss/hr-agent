              }
            ]
          }
        ],
        "recommendations": [
          {
            "text": "If you still have more than 5 days unused as year-end approaches, plan and request time off before December 31 so you don't lose the extra days."
          },
          {
            "text": "Check the HR Portal's expected carryover figure, which policy says is shown from the autumn onwards."
          }
        ]
