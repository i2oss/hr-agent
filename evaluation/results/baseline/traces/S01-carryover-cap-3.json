      "answer": {
        "lead": "You can carry over up to 5 unused PTO days into next year. Any unused days above 5 are forfeited on December 31.",
        "policy_facts": [
          {
            "text": "The carryover cap is 5 unused PTO days into the next calendar year. Days above the cap are forfeited on December 31, and forfeited days are not paid out.",
            "citations": [
              {
                "doc_id": "RSE-PTO-01",
                "section": "5.1",
                "snippet": "You can carry over up to 5 unused PTO days into the next calendar year."
              }
            ],
            "data_sources": []
          },
          {
            "text": "If you are on approved leave that spans December 31, such as parental leave, the cap is 10 days instead of 5. It is applied automatically when the leave is recorded in the HR Portal.",
            "citations": [
              {
                "doc_id": "RSE-PTO-01",
                "section": "5.2",
                "snippet": "If you are on approved leave that spans December 31, you can carry over up to 10 unused PTO days instead of 5."
              }
            ],
            "data_sources": []
          },
          {
            "text": "As of 2026-11-02, your PTO balance shows 11.0 days available. That figure includes 2.0 days carried over into this year, and you have no pending requests.",
